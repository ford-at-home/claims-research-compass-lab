{
  "processor": "core",
  "input": {
    "research_instructions": "Research only the stated corroboration question not covered by the existing weather, catastrophe or incident response. Do not duplicate routine loss verification. Distinguish observed events, warnings, forecasts, reporting delay, time and location uncertainty. A missing public report is insufficient evidence, not proof of no event or fraud.",
    "public_case_context": {
      "peril": "hail",
      "reported_local_time": "2024-05-26T18:30:00-05:00",
      "timezone": "America/Chicago",
      "window_minutes": 90,
      "location": {
        "zip": "75201",
        "state": "TX",
        "precision": "zip_area"
      },
      "radius_km": "10.00",
      "question": "What public event evidence overlaps this hypothetical loss?"
    },
    "discovered_source_excerpts": [],
    "research_scope": {
      "specific_question": "A specific missing local corroboration question after the existing source response is examined.",
      "primary_response_public_summary": null,
      "purpose": "unanswered_external_question",
      "execute_only_after_local_gate": true
    }
  },
  "task_spec": {
    "output_schema": {
      "type": "json",
      "json_schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Factual research summary; no settlement, coverage, approval, or fraud decision."
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "finding_id": {
                  "type": "string"
                },
                "entity_id": {
                  "type": "string",
                  "description": "Reference to an input line, vehicle, event, supplier, or question."
                },
                "attribute": {
                  "type": "string",
                  "description": "One atomic attribute per finding."
                },
                "value_text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Published value in its source wording."
                },
                "number_decimal": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Decimal string only when the source states a number; otherwise null."
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "For example USD per part, USD per hour, km, or minutes."
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "ISO currency code when relevant."
                },
                "evidence_type": {
                  "type": "string",
                  "enum": [
                    "asking_price",
                    "completed_sale",
                    "active_bid",
                    "posted_rate",
                    "supplier_quote",
                    "event_observation",
                    "warning",
                    "recall_campaign",
                    "vin_recall_status",
                    "shop_detail",
                    "other"
                  ]
                },
                "effective_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Source effective or event time when known; ISO 8601. Unknown stays null."
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Publication time when known; unknown stays null."
                },
                "source_observed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Source content observation time only if actually supplied; do not substitute run time."
                },
                "qualifiers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Fitment, geography, quantity, part condition, fees, scope, or uncertainty."
                  }
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Exact public source URL. Do not invent or use a search results URL."
                      },
                      "excerpt": {
                        "type": "string",
                        "description": "Exact source excerpt supporting this one fact, including qualifiers."
                      }
                    },
                    "required": [
                      "url",
                      "excerpt"
                    ],
                    "additionalProperties": false
                  }
                },
                "research_status": {
                  "type": "string",
                  "enum": [
                    "candidate",
                    "conflicting",
                    "insufficient",
                    "blocked"
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "finding_id",
                "entity_id",
                "attribute",
                "value_text",
                "number_decimal",
                "unit",
                "currency",
                "evidence_type",
                "effective_at",
                "published_at",
                "source_observed_at",
                "qualifiers",
                "citations",
                "research_status",
                "notes"
              ],
              "additionalProperties": false
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A missing fact or unresolved access/coverage limitation."
            }
          }
        },
        "required": [
          "summary",
          "findings",
          "gaps"
        ],
        "additionalProperties": false
      }
    }
  },
  "source_policy": {
    "include_domains": [
      "weather.gov",
      "noaa.gov"
    ]
  }
}
